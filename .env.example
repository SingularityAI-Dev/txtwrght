# LLM configuration: ordered failover chain of OpenAI-compatible endpoints,
# all localhost proxies, no cloud API keys. The client tries endpoint 1 first;
# on transport/auth failure it falls through to the next endpoint with a
# BASE_URL set. Parse-retry (2x) happens per endpoint before failing over.
# API_KEY blank = send no Authorization header.

# 1. CLIProxyAPI over the machine's Claude subscription (primary).
#    Brew service, always on. Key = the sk-local value from
#    /opt/homebrew/etc/cliproxyapi.conf api-keys.
LLM_1_BASE_URL=http://127.0.0.1:8317/v1
LLM_1_API_KEY=
LLM_1_MODEL=claude-sonnet-5

# 2. Hermes proxy, Nous Portal upstream (fallback).
#    Start with `hermes proxy start`; accepts any bearer token.
LLM_2_BASE_URL=http://127.0.0.1:8645/v1
LLM_2_API_KEY=hermd
LLM_2_MODEL=anthropic/claude-sonnet-5

# 3. spare slot (droid has no OpenAI-compatible HTTP surface; it rides the
#    same Claude subscription as endpoint 1, so it adds no redundancy)
LLM_3_BASE_URL=
LLM_3_API_KEY=
LLM_3_MODEL=

# Browser settings
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720

# Agent settings
MAX_STEPS=40
STEP_DELAY=0.5